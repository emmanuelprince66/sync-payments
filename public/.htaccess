# cPanel (Apache): every path that isn't a real file serves index.html, so React Router handles it
# and refreshing a page like /expenses or /loyalty doesn't 404. (On Netlify, netlify.toml does this.)
# Assumes the app sits at the domain or subdomain root, e.g. https://pay.example.com/.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # The service worker and manifest are always served as themselves, never swallowed by the SPA fallback.
  RewriteRule ^(sw\.js|registerSW\.js|workbox-[^/]+\.js|manifest\.webmanifest)$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Installable app (PWA): older Apache builds don't know the .webmanifest type.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# The hashed files in /assets can be cached for a year. index.html, the service worker and the manifest
# must never be cached, so a new upload shows straight away (the service worker then swaps in the new
# version). The no-cache block comes last so it wins for sw.js / registerSW.js over the *.js rule.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|workbox-.+\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
