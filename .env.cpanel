# Settings for the cPanel build: `npm run build:cpanel`, then upload the contents of dist/.
# cPanel has no Netlify proxy, so the app calls the API directly. The API only accepts browsers from
# domains on its allow-list (CORS): ask the backend to add each cPanel domain.
VITE_API_BASE_URL=https://api.sync360.africa/api/v1/
VITE_AUTH_MODE=api
# Keys don't go here (this file is on GitHub). Put them in .env.cpanel.local, which git ignores:
#   VITE_GEOAPIFY_KEY=your-key
