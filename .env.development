# Base URL the browser calls. In dev, keep "/api/v1/" so the Vite proxy forwards to VITE_API_PROXY_TARGET (no CORS).
# On Netlify, netlify.toml forwards /api/v1/* to the API, so keep "/api/v1/" there too.
VITE_API_BASE_URL=/api/v1/
VITE_API_PROXY_TARGET=https://staging-api.sync360.africa

# "api" = real backend. "mock" = no backend; demo sign-in and sample data for offline previews.
VITE_AUTH_MODE=api
